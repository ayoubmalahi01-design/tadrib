# THE TRAINERS (تدرّب) — public client configuration.
#
# These two values are safe to ship to the browser: the anon/publishable key is
# guarded by Row Level Security, and every table is protected by policies.
#
# NEVER put a service-role key, a database password or any other secret in this
# file. Anything here is bundled into the public JavaScript.

VITE_SUPABASE_URL=https://ikrfxvxbqrmcnnzwrhsz.supabase.co

# The client accepts either key name. Provide exactly one:
#   - newer Supabase projects call it the "publishable" key
#   - older projects call it the "anon" key
# VITE_SUPABASE_ANON_KEY=<legacy anon key>
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ORSjXiE-TbZx1nyD0HDZbg_poepahV6
